{
  "name": "cheat-guard",
  "version": "1.0.0",
  "description": "实时 AI 桌面助手 - 隐形覆盖层",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "electron-builder",
    "build-native": "node-gyp rebuild --directory src/native",
    "build-native:debug": "node-gyp rebuild --directory src/native --debug"
  },
  "keywords": [
    "electron",
    "ai",
    "overlay",
    "assistant"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "node-addon-api": "^7.0.0",
    "node-gyp": "^10.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "koffi": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.cheatguard.app",
    "productName": "CheatGuard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
