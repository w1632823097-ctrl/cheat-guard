{
  "name": "cheat-guard",
  "version": "1.0.0",
  "description": "实时 AI 桌面助手 - 隐形覆盖层",
  "main": "dist/main.js",
  "scripts": {
    "dev": "chcp 65001 >nul && tsc && electron .",
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "electron-builder",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && electron-builder --win",
    "build-native": "node-gyp rebuild --directory src/native",
    "build-native:debug": "node-gyp rebuild --directory src/native --debug"
  },
  "keywords": [
    "electron",
    "ai",
    "overlay",
    "assistant"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "node-addon-api": "^7.0.0",
    "node-gyp": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.11.1",
    "koffi": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.cheatguard.app",
    "productName": "CheatGuard",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CheatGuard-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CheatGuard"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
