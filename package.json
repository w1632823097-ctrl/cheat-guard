{
  "name": "cheat-guard",
  "version": "1.0.0",
  "description": "实时 AI 桌面助手 - 隐形覆盖层",
  "main": "dist/main.js",
  "scripts": {
    "dev": "chcp 65001 >nul && tsc && vite build --config vite.config.ts && electron .",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "npm run build && electron .",
    "dist": "electron-builder",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && electron-builder --win",
    "build-native": "node-gyp rebuild --directory src/native",
    "build-native:debug": "node-gyp rebuild --directory src/native --debug",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug"
  },
  "keywords": [
    "electron",
    "ai",
    "overlay",
    "assistant"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "node-addon-api": "^7.0.0",
    "node-gyp": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.18.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "koffi": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "vite": "^4.5.14",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.cheatguard.app",
    "productName": "CheatGuard",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@koromix/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CheatGuard-${version}.${ext}",
      "signAndEditExecutable": false,
      "sign": null
    },
    "mac": {
      "target": "dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "w1632823097-ctrl",
      "repo": "cheat-guard"
    }
  }
}
